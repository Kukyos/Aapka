# Copy to .env and fill in what you have. Everything here is optional:
# with no .env at all the system runs fully offline on its deterministic paths,
# which is the behaviour gate G1 requires anyway.

# ---- Inference (optional)
# Groq is the cloud rung. Without it the kiosk falls back to Ollama, then to the
# deterministic keyword matcher, which handles most direct answers on its own.
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_ASR_MODEL=whisper-large-v3

# Local fallback. Start with: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Short on purpose: a patient at a kiosk will not wait, and the offline rung is
# always available.
LLM_TIMEOUT_S=6

# ---- ABDM
# mock    build the real FHIR bundle, write it to disk, do not transmit
# sandbox post to the real ABDM sandbox (needs the three values below)
ABDM_MODE=mock
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ---- Behaviour
DEFAULT_MODE=ayush
DEFAULT_LANGUAGE=hi
INACTIVITY_TIMEOUT_S=90

# ---- Doctor screen
# A single shared token is enough for a demo and for one consulting room. A real
# deployment authenticates against the hospital's own directory.
DOCTOR_TOKEN=demo-doctor-token
